{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "bacon/bacon-qr-code": "^3.0",
        "beyondcode/laravel-websockets": "^2.0@beta",
        "bluem/tree": "^3.2",
        "chencongbao/ajcaptcha": "*",
        "chencongbao/apidoc": "*",
        "chencongbao/foundation": "^1.11",
        "chencongbao/laravel-vue-i18n-generator": "^1.0",
        "chencongbao/math-parser": "^1.0",
        "chencongbao/openai": "^1.0",
        "chriskonnertz/deeply": "^2.2",
        "chriskonnertz/string-calc": "^2.0",
        "curl/curl": "*",
        "dcat/easy-excel": "^1.1",
        "dcat/laravel-admin": "2.*",
        "fakerphp/faker": "^1.24",
        "firebase/php-jwt": "^6.11",
        "guzzlehttp/guzzle": "^7.2",
        "irazasyed/telegram-bot-sdk": "^3.14",
        "itbdw/ip-database": "^3.0",
        "jiaxincui/closure-table": "^2.1",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "laravel-notification-channels/telegram": "^3.0",
        "laravel/framework": "^9.19",
        "laravel/horizon": "^5.31",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.7",
        "mateusjunges/laravel-kafka": "^1.13",
        "mervick/aes-bridge": "^2.0",
        "mews/captcha": "3.3.3",
        "pragmarx/google2fa-qrcode": "^2.0|^3.0",
        "pusher/pusher-php-server": "7.0",
        "richard/payment": "dev-master",
        "spatie/laravel-activitylog": "^4.10",
        "viest/php-ext-xlswriter-ide-helper": "dev-master",
        "web3p/web3.php": "dev-master"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tron\\": "app/Extendtions/Tron/tron-php/",
            "IEXBase\\TronAPI\\": "app/Extendtions/Tron/tron-api/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Functions/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/MerchantAdmin/FakeFutureClasses.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.phelotto.com/composer/"
        }
    ]
}
